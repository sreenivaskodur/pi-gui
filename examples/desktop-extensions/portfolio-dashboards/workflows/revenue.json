{
  "id": "revenue",
  "label": "Revenue vs budget",
  "description": "Compute monthly revenue against budget from revenue.csv.",
  "dataset": "revenue.csv",
  "report": {
    "title": "Revenue vs budget",
    "subtitle": "Computed from revenue.csv — monthly actuals against the board budget.",
    "asOf": "Computed from {source} · {rows} months",
    "stats": [
      {
        "label": "Revenue to date",
        "agg": "sum",
        "column": "actual",
        "format": "money",
        "delta": { "againstColumn": "budget", "unit": "% vs budget" }
      },
      {
        "label": "Latest month",
        "agg": "last",
        "column": "actual",
        "format": "money",
        "delta": { "againstColumn": "budget", "unit": "% vs budget" }
      },
      { "label": "Best month", "agg": "max", "column": "actual", "format": "money" },
      { "label": "Months tracked", "agg": "count", "format": "int" }
    ],
    "charts": [
      {
        "kind": "cartesian",
        "title": "Monthly revenue against budget, $M",
        "categoryColumn": "month",
        "series": [
          { "name": "Actual", "kind": "bar", "column": "actual", "slot": 1 },
          { "name": "Budget", "kind": "line", "column": "budget", "slot": 2, "dashed": true }
        ],
        "format": "money",
        "yZero": true
      }
    ],
    "tables": [
      {
        "title": "By month",
        "columns": [
          { "label": "Month", "column": "month", "align": "left", "strong": true },
          { "label": "Actual", "column": "actual", "format": "money", "align": "right" },
          { "label": "Budget", "column": "budget", "format": "money", "align": "right" },
          { "label": "vs budget", "deltaColumns": ["actual", "budget"], "align": "right" }
        ]
      }
    ]
  }
}
