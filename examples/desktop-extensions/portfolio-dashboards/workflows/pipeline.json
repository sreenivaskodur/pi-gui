{
  "id": "pipeline",
  "label": "Deal pipeline",
  "description": "Rank active deals in pipeline.csv by enterprise value.",
  "dataset": "pipeline.csv",
  "report": {
    "title": "Deal pipeline",
    "subtitle": "Computed from pipeline.csv — active opportunities by enterprise value and stage.",
    "asOf": "Computed from {source} · {rows} deals",
    "stats": [
      { "label": "Active deals", "agg": "count", "format": "int" },
      { "label": "Combined EV", "agg": "sum", "column": "ev", "format": "money0" },
      { "label": "Largest deal", "agg": "max", "column": "ev", "format": "money0" },
      { "label": "Average EV", "agg": "avg", "column": "ev", "format": "money0" }
    ],
    "charts": [
      {
        "kind": "hbars",
        "title": "Enterprise value by deal, $M",
        "labelColumn": "deal",
        "valueColumn": "ev",
        "emphasizeMax": true,
        "format": "money0",
        "seriesName": "Enterprise value"
      }
    ],
    "tables": [
      {
        "title": "Stage and status",
        "columns": [
          { "label": "Deal", "column": "deal", "align": "left", "strong": true },
          { "label": "EV", "column": "ev", "format": "money0", "align": "right" },
          { "label": "Stage", "column": "stage", "align": "right" },
          {
            "label": "Status",
            "column": "status",
            "align": "right",
            "pillMap": { "On track": "good", "Watching": "warning", "Queued": "neutral" }
          }
        ]
      }
    ]
  }
}
