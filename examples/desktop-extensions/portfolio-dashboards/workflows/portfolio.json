{
  "id": "portfolio",
  "label": "Portfolio overview",
  "description": "Aggregate every company in companies.csv against its EBITDA budget.",
  "dataset": "companies.csv",
  "report": {
    "title": "Portfolio overview",
    "subtitle": "Computed from companies.csv — each company's LTM performance against its EBITDA budget.",
    "asOf": "Computed from {source} · {rows} companies",
    "stats": [
      {
        "label": "Portfolio LTM revenue",
        "agg": "sum",
        "column": "ltm_revenue",
        "format": "money0"
      },
      {
        "label": "Portfolio LTM EBITDA",
        "agg": "sum",
        "column": "ltm_ebitda",
        "format": "money0",
        "delta": { "againstColumn": "budget_ebitda", "unit": "% vs budget" }
      },
      { "label": "Companies", "agg": "count", "format": "int" },
      { "label": "Top EBITDA", "agg": "max", "column": "ltm_ebitda", "format": "money" }
    ],
    "charts": [
      {
        "kind": "cartesian",
        "title": "LTM EBITDA vs budget by company, $M",
        "subtitle": "Actual EBITDA against each company's budget.",
        "categoryColumn": "company",
        "series": [
          { "name": "LTM EBITDA", "kind": "bar", "column": "ltm_ebitda", "slot": 1 },
          { "name": "Budget", "kind": "line", "column": "budget_ebitda", "slot": 2, "dashed": true }
        ],
        "format": "money"
      }
    ],
    "tables": [
      {
        "title": "Companies",
        "subtitle": "LTM revenue and EBITDA, variance measured against each company's budget.",
        "columns": [
          { "label": "Company", "column": "company", "align": "left", "strong": true },
          { "label": "LTM revenue", "column": "ltm_revenue", "format": "money", "align": "right" },
          { "label": "LTM EBITDA", "column": "ltm_ebitda", "format": "money", "align": "right" },
          {
            "label": "vs budget",
            "deltaColumns": ["ltm_ebitda", "budget_ebitda"],
            "align": "right"
          },
          {
            "label": "Status",
            "column": "status",
            "align": "right",
            "pillMap": { "On track": "good", "Watching": "warning", "At risk": "serious" }
          }
        ]
      }
    ]
  }
}
